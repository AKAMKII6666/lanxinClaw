{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanxing.local/schemas/job.schema.json",
  "title": "Lanxing Claw Job",
  "type": "object",
  "required": ["jobId", "affairId", "executor", "status", "goal", "allowedPermissions"],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "affairId": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "enum": ["openclaw"]
    },
    "status": {
      "enum": ["queued", "running", "needs_permission", "blocked", "completed", "failed", "canceled"]
    },
    "purpose": {
      "enum": ["execution", "exploration"]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "workspaceHint": {
      "type": ["string", "null"]
    },
    "allowedPermissions": {
      "type": "array",
      "items": {
        "$ref": "permission.schema.json#/$defs/permissionId"
      }
    },
    "progressSummary": {
      "type": "string"
    },
    "recentSteps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["at", "kind", "text"],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": ["tool", "lifecycle", "reply", "task"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "resultDigest": {
      "type": ["string", "null"]
    },
    "evidenceQuality": {
      "enum": ["missing", "weak", "present"]
    },
    "blockedReason": {
      "type": ["string", "null"]
    },
    "resumeCondition": {
      "type": ["string", "null"]
    },
    "permissionRequestId": {
      "type": ["string", "null"]
    },
    "taskIntentId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "statusReasonCode": {
      "type": ["string", "null"]
    },
    "statusObservedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

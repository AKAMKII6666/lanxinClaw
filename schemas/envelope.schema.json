{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanxing.local/schemas/envelope.schema.json",
  "title": "Lanxing Claw Protocol Envelope",
  "type": "object",
  "required": ["protocolVersion", "messageId", "sentAt", "source", "target", "type", "payload"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.2"
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/endpoint"
    },
    "target": {
      "$ref": "#/$defs/endpoint"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_]+$"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["kind", "deviceId"],
      "properties": {
        "kind": {
          "enum": ["phone", "companion", "adapter"]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}


{
  "name": "@lanxin-claw/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "澜星 Claw 桌面 companion：discovery、pairing、identity、Electron 壳",
  "main": "./dist/main/main-entry.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "demo:low-risk": "tsx ../../scripts/low-risk-job/run-readonly-check.ts",
    "e2e:v1.3": "tsx ../../scripts/e2e/run-v1-3-loop.ts",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:shell": "npm run build:renderer && npm run build:main",
    "start:shell": "npm run build:shell && electron .",
    "dev:shell": "npm run build:main && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env LANXIN_RENDERER_URL=http://127.0.0.1:5173/ electron .\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@lanxin-claw/mock-companion": "0.1.0",
    "@lanxin-claw/openclaw-adapter": "0.1.0",
    "@lanxin-claw/protocol": "0.1.0",
    "@mui/material": "^6.4.0",
    "bonjour-service": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
